{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleDetection": "force",
		"lib": ["ES2022"],
		"verbatimModuleSyntax": true,
		"rewriteRelativeImportExtensions": true,
		"jsx": "react-jsx",
		"jsxImportSource": "@opentui/react",
		"strict": true,
		"exactOptionalPropertyTypes": true,
		"noUnusedLocals": true,
		"noImplicitOverride": true,
		"noFallthroughCasesInSwitch": true,
		"noUncheckedIndexedAccess": true,
		"skipLibCheck": true,
		"types": ["bun"],
		"plugins": [{ "name": "@effect/language-service" }],
		"paths": {
			"@ghui/keymap": ["./packages/keymap/src/index.ts"],
			"@ghui/keymap/react": ["./packages/keymap/src/react.ts"]
		}
	},
	"include": ["src/**/*.ts", "src/**/*.tsx", "dev/**/*.ts", "dev/**/*.tsx", "packages/**/*.ts"]
}
